// .devcontainer/devcontainer.json
{
  "name": "Edge AI Causal FMEA Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "CUDA_ARCH": "89"
    }
  },
  
  "remoteUser": "hehe",

  "runArgs": [
    "--gpus", "all",
    "--shm-size", "8g"
  ],

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/causal_fmea_system,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/causal_fmea_system",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "ms-vscode.cpptools",
        "charliermarsh.ruff"
      ],
      "settings": {
        // 🌟 物理瞄准：直接将 VS Code 的默认解释器锁死在我们镜像里构建好的沙盒上！
        "python.defaultInterpreterPath": "/home/hehe/.venv/bin/python3",
        "rust-analyzer.cargo.features": "all"
      }
    }
  }
}